# Settings for docker-compose.yml. Copy this file to ".env".

# The Pandora root folder on the host/NAS. This is the folder, which the
# slaves and workstations use as their Pandora root (e.g. a network share).
PANDORA_ROOT_HOST=/volume1/pandora

# User and group, who own the files in the Pandora root folder.
# Run "id" on the host to find the ids of your user.
PUID=1000
PGID=1000

# Timezone for the timestamps in the logs.
TZ=Europe/Berlin

# true:  all machines access the Pandora root folder directly (network share, VPN)
# false: slaves and workstations use a synchronized copy (e.g. Syncthing, Dropbox)
PANDORA_LOCAL_MODE=true
